# Copy this file to `.env` and fill in your Supabase project values.
# Only PUBLIC (anon) values belong in the mobile client. NEVER put a
# service-role key here or anywhere in the app bundle.
#
# The EXPO_PUBLIC_ prefix is required for the value to be readable from
# process.env at runtime in Expo.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
